<Application x:Class="ExamTicketGenerator.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="Ink" Color="#F8FAFC" />
        <SolidColorBrush x:Key="Muted" Color="#94A3B8" />
        <SolidColorBrush x:Key="Panel" Color="#172033" />
        <SolidColorBrush x:Key="PanelLight" Color="#1E293B" />
        <SolidColorBrush x:Key="Accent" Color="#6EE7B7" />
        <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe UI" /><Setter Property="Foreground" Value="{StaticResource Ink}" /></Style>
        <Style TargetType="ComboBox"><Setter Property="Height" Value="44" /><Setter Property="FontSize" Value="15" /><Setter Property="Padding" Value="12,0" /><Setter Property="Background" Value="#243047" /><Setter Property="Foreground" Value="{StaticResource Ink}" /><Setter Property="BorderBrush" Value="#334155" /></Style>
        <Style TargetType="Button"><Setter Property="FontFamily" Value="Segoe UI Semibold" /><Setter Property="FontSize" Value="15" /><Setter Property="Foreground" Value="#052E2B" /><Setter Property="Background" Value="{StaticResource Accent}" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="20,0" /><Setter Property="Cursor" Value="Hand" /></Style>
    </Application.Resources>
</Application>
