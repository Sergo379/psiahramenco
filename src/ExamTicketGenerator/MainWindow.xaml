<Window x:Class="ExamTicketGenerator.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="LOFT / Ticket Studio" Width="1140" Height="790" MinWidth="1020" MinHeight="740" WindowStartupLocation="CenterScreen">
<Grid Background="#191A18" TextOptions.TextRenderingMode="Grayscale">
    <Grid.ColumnDefinitions><ColumnDefinition Width="270"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#22231F" BorderBrush="#363730" BorderThickness="0,0,1,0">
        <Grid Margin="30,32">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel>
                <StackPanel Orientation="Horizontal"><Border Width="35" Height="35" BorderBrush="#EDAF70" BorderThickness="1" CornerRadius="7"><TextBlock Text="L" FontFamily="Georgia" FontSize="23" Foreground="#EDAF70" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="LOFT / STUDIO" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" Margin="12,0,0,0"/></StackPanel>
                <TextBlock Text="EXAMINATION WORKSPACE" FontSize="9" Foreground="#86887A" Margin="0,15,0,50"/>
                <Border Background="#35342C" BorderBrush="#57503E" BorderThickness="1" CornerRadius="8" Padding="16"><StackPanel Orientation="Horizontal"><TextBlock Text="◈" Foreground="#EDAF70" FontSize="19" Margin="0,0,12,0"/><TextBlock Text="Выдача билетов" FontSize="14" VerticalAlignment="Center"/></StackPanel></Border>
                <TextBlock Text="РАБОЧИЕ ФАЙЛЫ" Foreground="#8F9085" FontSize="10" Margin="0,36,0,15"/>
                <Button Content="↻  Обновить источники" Style="{StaticResource SecondaryButton}" Click="ReloadClicked" HorizontalContentAlignment="Left" Margin="0,0,0,10"/>
                <Button Content="↗  Открыть папку данных" Style="{StaticResource SecondaryButton}" Click="FolderClicked" Margin="0,0,0,10"/>
                <Button Content="▤  Открыть журнал" Style="{StaticResource SecondaryButton}" Click="JournalClicked"/>
            </StackPanel>
            <StackPanel Grid.Row="2">
                <Border BorderBrush="#44453D" BorderThickness="0,1,0,0" Padding="0,22,0,0"><StackPanel><TextBlock Text="Один студент. Один билет." FontFamily="Georgia" FontSize="20" Foreground="#DCD5C7"/><TextBlock Text="Каждая выдача — новая запись в истории. Номер закрепляется при первом выборе." FontSize="12" Foreground="#989B8D" LineHeight="19" Margin="0,12,0,0"/></StackPanel></Border>
                <TextBlock Text="LAB 02  /  DESKTOP EDITION" Foreground="#7C8072" FontSize="9" Margin="0,25,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
    <Grid Grid.Column="1" Margin="40,30,40,24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid>
            <TextBlock Text="УЧЕБНАЯ СЕССИЯ / 2026" Foreground="#B4AB97" FontSize="10" VerticalAlignment="Center"/>
            <Border Background="#282C24" CornerRadius="14" Padding="12,6" HorizontalAlignment="Right"><StackPanel Orientation="Horizontal"><Ellipse Width="6" Height="6" Fill="#A0B985" Margin="0,0,7,0"/><TextBlock x:Name="ReadyText" Text="Проверка данных" FontSize="10" Foreground="#B8C7A5"/></StackPanel></Border>
        </Grid>
        <StackPanel Grid.Row="1" Margin="0,24,0,24">
            <TextBlock Text="Ваш следующий билет." FontFamily="Georgia" FontSize="42" Foreground="#F1E9DA"/>
            <TextBlock Text="Немного случайности. Полный порядок в журнале." FontSize="14" Foreground="#AAA99E" Margin="0,10,0,0"/>
        </StackPanel>
        <UniformGrid Grid.Row="2" Columns="3" Margin="0,0,0,24">
            <Border Background="#242521" BorderBrush="#3D3E37" BorderThickness="1" CornerRadius="8" Padding="18,14" Margin="0,0,10,0"><StackPanel><TextBlock Text="ГРУППЫ" Foreground="#929488" FontSize="10"/><TextBlock x:Name="GroupsCountText" Text="—" FontSize="27" FontFamily="Georgia" Margin="0,6,0,0"/></StackPanel></Border>
            <Border Background="#242521" BorderBrush="#3D3E37" BorderThickness="1" CornerRadius="8" Padding="18,14" Margin="0,0,10,0"><StackPanel><TextBlock Text="СТУДЕНТЫ" Foreground="#929488" FontSize="10"/><TextBlock x:Name="StudentsCountText" Text="—" FontSize="27" FontFamily="Georgia" Margin="0,6,0,0"/></StackPanel></Border>
            <Border Background="#302C23" BorderBrush="#5A4C37" BorderThickness="1" CornerRadius="8" Padding="18,14"><StackPanel><TextBlock Text="БИЛЕТЫ" Foreground="#C1A078" FontSize="10"/><TextBlock x:Name="TicketsCountText" Text="—" Foreground="#EDAF70" FontSize="27" FontFamily="Georgia" Margin="0,6,0,0"/></StackPanel></Border>
        </UniformGrid>
        <Border Grid.Row="3" Background="#292A25" BorderBrush="#45453C" BorderThickness="1" CornerRadius="12" Padding="26">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid><TextBlock Text="Новая выдача" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="01 / ВЫБОР УЧАСТНИКА" FontSize="9" Foreground="#B1A38B" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
                <Grid Grid.Row="1" Margin="0,24,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="Группа" Foreground="#C4BFB1" FontSize="12" Margin="0,0,0,9"/><ComboBox x:Name="GroupCombo" SelectionChanged="GroupChanged" DisplayMemberPath="Name"/></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="Студент" Foreground="#C4BFB1" FontSize="12" Margin="0,0,0,9"/><ComboBox x:Name="StudentCombo" IsEnabled="False" SelectionChanged="StudentChanged" DisplayMemberPath="DisplayName"/></StackPanel>
                </Grid>
                <TextBlock x:Name="SelectionHint" Grid.Row="2" Text="Начните с выбора группы." FontSize="12" Foreground="#9C9D91" Margin="0,12,0,0"/>
                <Grid Grid.Row="4" Margin="0,25,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center" Margin="0,0,15,0"><TextBlock Text="СОХРАНЕНИЕ АВТОМАТИЧЕСКИ" Foreground="#B1A38B" FontSize="9"/><TextBlock Text="Excel-журнал · полная история" Foreground="#9C9D91" FontSize="11" Margin="0,5,0,0"/></StackPanel><Button x:Name="GenerateButton" Grid.Column="1" Content="Сгенерировать билет   ↗" IsEnabled="False" Click="GenerateClicked" MinWidth="224"/></Grid>
            </Grid>
        </Border>
        <Border Grid.Row="4" BorderBrush="#383A32" BorderThickness="0,1,0,0" Margin="0,22,0,0" Padding="0,16,0,0"><TextBlock x:Name="StatusText" Text="Загрузка источников…" Foreground="#A3A697" FontSize="12"/></Border>
    </Grid>
</Grid>
</Window>
