<Window x:Class="ExamTicketGenerator.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Ticket Studio" Width="900" Height="620" MinWidth="760" MinHeight="540" WindowStartupLocation="CenterScreen" Background="#0B1220">
    <Grid Margin="42">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="TICKET STUDIO" FontSize="13" FontWeight="SemiBold" Foreground="#6EE7B7" />
            <TextBlock Text="Генератор экзаменационных билетов" FontSize="32" FontWeight="Bold" Margin="0,8,0,4" />
            <TextBlock Text="Выберите группу и студента — система сохранит результат в журнал автоматически." FontSize="15" Foreground="#94A3B8" />
        </StackPanel>
        <Border Grid.Row="1" Background="#172033" CornerRadius="20" Padding="34" Margin="0,30,0,25">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="Новая выдача" FontSize="21" FontWeight="SemiBold" />
                <Grid Grid.Row="1" Margin="0,28,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="28"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="ГРУППА" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,8" />
                        <ComboBox x:Name="GroupCombo" SelectionChanged="GroupChanged" DisplayMemberPath="Name" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Grid.ColumnSpan="2" Margin="28,0,0,0">
                        <TextBlock Text="СТУДЕНТ" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,8" />
                        <ComboBox x:Name="StudentCombo" SelectionChanged="StudentChanged" DisplayMemberPath="DisplayName" />
                    </StackPanel>
                </Grid>
                <Border Grid.Row="2" Background="#1E293B" CornerRadius="14" Margin="0,30,0,25" Padding="20">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="ПОДСКАЗКА" FontSize="11" FontWeight="SemiBold" Foreground="#6EE7B7" />
                        <TextBlock Text="Номер билета закрепляется за студентом при первой выдаче. Повторная выдача добавит новую строку в журнал с тем же номером." TextWrapping="Wrap" FontSize="15" Foreground="#CBD5E1" Margin="0,7,0,0" />
                    </StackPanel>
                </Border>
                <Button x:Name="GenerateButton" Grid.Row="3" Height="52" HorizontalAlignment="Right" Content="Сгенерировать билет  →" Click="GenerateClicked" IsEnabled="False" />
            </Grid>
        </Border>
        <Grid Grid.Row="2">
            <TextBlock x:Name="StatusText" Text="Проверяю входные файлы…" Foreground="#94A3B8" VerticalAlignment="Center" />
            <TextBlock Text="ESC — закрыть окно билета" Foreground="#64748B" HorizontalAlignment="Right" />
        </Grid>
    </Grid>
</Window>
