<Window x:Class="ExamTicketGenerator.TicketWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Ваш билет" Width="620" SizeToContent="Height" WindowStartupLocation="CenterOwner" Background="#0B1220" ResizeMode="NoResize" PreviewKeyDown="KeyPressed">
    <Border Margin="22" Padding="32" Background="#172033" CornerRadius="18">
        <StackPanel>
            <TextBlock Text="ВАШ ЭКЗАМЕНАЦИОННЫЙ БИЛЕТ" FontSize="12" FontWeight="SemiBold" Foreground="#6EE7B7" />
            <TextBlock x:Name="NumberText" FontSize="36" FontWeight="Bold" Margin="0,12,0,5" />
            <TextBlock x:Name="RepeatText" Foreground="#FBBF24" FontSize="13" Margin="0,0,0,25" />
            <ItemsControl x:Name="QuestionsList">
                <ItemsControl.ItemTemplate><DataTemplate><Border Background="#1E293B" CornerRadius="10" Padding="16" Margin="0,0,0,10"><TextBlock TextWrapping="Wrap" FontSize="16" Text="{Binding}" /></Border></DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Нажмите ESC, чтобы вернуться к выбору студента" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,18,0,0" />
        </StackPanel>
    </Border>
</Window>
